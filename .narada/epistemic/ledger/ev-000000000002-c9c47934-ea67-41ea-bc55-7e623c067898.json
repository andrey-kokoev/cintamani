  "operations": [
    {
      "entity_id": "prob:vrc-architecture-inverse-design",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Given programmable nonlinear three-dimensional physical matter, what computational architecture should be trained to inhabit it?"
    },
    {
      "entity_id": "prob:recurrence-depth-scaling",
      "kind": "problem",
      "op": "entity.declare",
      "title": "At fixed operator and fixed state size, does increasing recurrence count T increase performance, and do harder inputs benefit more than easy ones?"
    },
    {
      "entity_id": "prob:recurrence-vs-depth-substitution",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Can additional recurrence substitute for additional architectural depth on compositional tasks?"
    },
    {
      "entity_id": "prob:controllable-computational-possibility",
      "kind": "problem",
      "op": "entity.declare",
      "title": "How much controllable computational possibility does a candidate physical volume actually contain, and does it have a bounded, persistent, high-dimensional operating regime that is neither chaos nor collapse?"
    },
    {
      "entity_id": "prob:controllable-directions-and-time-scaling",
      "kind": "problem",
      "op": "entity.declare",
      "title": "How many independently useful computational directions does the substrate provide, and how much additional computation can the same substrate obtain by evolving for longer?"
    },
    {
      "entity_id": "prob:persistent-volumetric-state-material",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Which material can provide the greatest density of independently programmable, persistent, optically coupled computational state; is CsPbBr3 in glass viable with the required persistence, selectivity, rewritability, and scale?"
    },
    {
      "entity_id": "prob:entropy-qualified-not-trainable",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Why did entropy-qualified dynamics fail to become trainable corrective computation in the first task-level test?"
    },
    {
      "entity_id": "prob:compositional-property-material-category",
      "kind": "problem",
      "op": "entity.declare",
      "title": "What compositional property of a material's physical process category determines which logical process categories it can realize under bounded resources?"
    },
    {
      "entity_id": "prob:functorial-depth-invariant",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Identify an invariant or monotone mu that produces a nontrivial bound between the logical and physical process theories"
    },
    {
      "entity_id": "prob:litao3-escape-resource",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Does a fabricated thin-film LiTaO3 device stay inside the declared affine model, and which additional physical resource can escape it compositionally?"
    },
    {
      "entity_id": "prob:kerr-redistribution-utility",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Does driven LiTaO3 Kerr dynamics supply a stable, resource-efficient redistribution of capacity into the particular nonlinear delayed functions required by a predeclared task while retaining enough input memory to compose them?"
    },
    {
      "entity_id": "prob:conjecture-5-gate",
      "kind": "problem",
      "op": "entity.declare",
      "title": "Find a connected, perturbation-tolerant LiTaO3 regime satisfying the 7 gate conditions (replicated nonlinear delayed capacity with retained input memory under charged controls and resources) before Conjecture 5 may be formulated"
    },
    {
      "entity_id": "conj:recurrence-difficulty-scaling",
      "kind": "conjecture",
      "op": "entity.declare",
      "title": "For sufficiently difficult but solvable inputs, performance increases with recurrence count T, and the recurrence advantage grows with input difficulty"
    },
    {
      "entity_id": "conj:ecd-capacity",
      "kind": "conjecture",
      "op": "entity.declare",
      "title": "The useful computational capacity of a VRC substrate is determined primarily by its effective controllable dimension (singular directions of the configuration-response Jacobian above the noise floor), not by its raw number of physical sites"
    },
    {
      "entity_id": "conj:on3-persistence",
      "kind": "conjecture",
      "op": "entity.declare",
      "title": "N_ECD = O(N^3) for an N x N x N lattice only when every volumetric site supports an independently programmable, persistent, optically readable, reconfigurable local state"
    },
    {
      "entity_id": "conj:functorial-depth-criterion",
      "kind": "conjecture",
      "op": "entity.declare",
      "title": "Resource-honest functorial depth (Conjecture 4) demoted to a non-empirical audit criterion: presentation-relative depth with no-fast-forward, explicit resources, bounded interfaces, compositional error structure"
    },
    {
      "entity_id": "conj:kerr-quadrature-linear-memory-lead",
      "kind": "conjecture",
      "op": "entity.declare",
      "title": "At detector-observation-noise std 1e-8 at the frozen normalized point, the Kerr lag-three and lag-four linear targets remain family-wise significant across seeds 20260810-20260812 and every matched Kerr-minus-disabled corrected-capacity delta remains positive"
    },
    {
      "entity_id": "claim:lt-aff-1-linear-degree-obstruction",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Proposition LT-AFF-1 (proved within the declared model): fixed affine LiTaO3 optics with linear amplitude encoding and terminal square-law detection yields detector outputs of algebraic degree at most 2 for every recurrence count, so it cannot realize g^t(z)=z^(2^t) for t >= 2"
    },
    {
      "entity_id": "claim:lt-kerr-1-capacity-bound",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Proposition LT-KERR-1 (application of Dambre et al. 2012, not a new empirical conjecture): at fixed real observation count N with linear readout, total information-processing capacity C_total(t) <= N for all dwell times, recurrence counts, Kerr strengths, pump powers, and detunings"
    },
    {
      "entity_id": "claim:lt-kerr-2-honest-readout",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Proposition LT-KERR-2: retaining T observation time samples gives dimension at most NT; capacity gained thereby is attributable to an enlarged readout interface, not recurrence-created capacity"
    },
