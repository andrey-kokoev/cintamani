  "operations": [
    {
      "entity_id": "crit:low-rank-optical-addressing",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Dimension-counting obstruction: three intersecting optical control fields produce theta_ijk = f(a_i, b_j, c_k) from only 3N controls, so reachable configuration dimension is about O(N) (at most O(N^2) with line-indexed fields), not O(N^3)"
    },
    {
      "entity_id": "crit:entropy-richness-insufficient",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Bounded, persistent, high-rank dynamics were not sufficient for useful learned computation: entropy-passing properties failed to become trainable corrective computation"
    },
    {
      "entity_id": "crit:enumeration-not-explanation",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Deutsch-Popperian discipline: enumeration is not explanation; a taxonomy can absorb every outcome and scorecards can optimize proxies without explaining why a physical system should acquire computational depth"
    },
    {
      "entity_id": "crit:free-category-functor-automatic",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "The mere existence of a functor from the free category generated by g is not evidence: any chosen physical endomorphism f induces such a functor automatically"
    },
    {
      "entity_id": "crit:formal-degree-infinite-kerr",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Formal polynomial degree fails as a Kerr depth invariant: even single-mode self-phase modulation has generically infinite Taylor order for any nonzero t, so formal degree would declare almost instantaneous infinite depth"
    },
    {
      "entity_id": "crit:raw-capacity-sum-invalid",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "An uncorrected sum over many capacity targets is not an admissible success metric: the raw Kerr-over-control ordering reversed after bias correction"
    },
    {
      "entity_id": "crit:square-law-detector-confound",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "The dominant apparent nonlinear capacity in the first Kerr control run was square-law detector capacity, not Kerr computation; detector and decoder nonlinearities are resources that must be charged"
    },
    {
      "entity_id": "crit:rank-not-operational",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Standardization can make a vanishingly weak comb line look as readable as a strong line; mathematical observation rank is not yet operational rank"
    },
    {
      "entity_id": "crit:readout-amplification-severe",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Raw readout amplification remains severe at the passed noise gate: raw-equivalent weight norms of gate-target readouts are 1.24e6 to 4.94e6, with no actuator or dynamic-range constraint imposed"
    },
    {
      "entity_id": "crit:noise-model-simplistic",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "The detector-noise model is independent additive Gaussian noise in normalized quadrature coordinates: correlation, phase dependence, local-oscillator limits, bandwidth, quantization, drift, and shot noise are unmodeled"
    },
    {
      "entity_id": "crit:chi2-frequency-ladder",
      "kind": "criticism",
      "op": "entity.declare",
      "title": "Chi(2) second-harmonic generation breaks the affine invariant locally but is not a fixed endomorphism: repeated doubling demands an exponentially increasing frequency ladder and leaves any finite transparency window"
    },
    {
