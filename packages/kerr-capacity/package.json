{
  "name": "@cintamani/kerr-capacity",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "cargo build",
    "check": "cargo check --all-targets",
    "test": "cargo test --all-targets",
    "run:smoke": "cargo run -- run configs/smoke.toml --output output/smoke",
    "run:linear-control": "cargo run -- run configs/linear-control.toml --output output/linear-control",
    "controls": "cargo run --release -- controls configs/smoke.toml --output output/controls",
    "noise-suite:frozen": "cargo run --release -- noise-suite configs/detector-noise-frozen.toml --output output/detector-noise-frozen",
    "db-check": "cargo run -- db-check output/controls/results.sqlite",
    "cross-check": "cargo run -- cross-check configs/smoke.toml"
  }
}
