{
  "name": "@cintamani/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "generate:data": "node scripts/generate-domain-snapshots.mjs --write",
    "check:data": "node scripts/generate-domain-snapshots.mjs --check",
    "dev": "pnpm run generate:data && astro dev",
    "build": "pnpm run generate:data && astro build",
    "check": "pnpm run check:data && astro check",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview",
    "ship": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "7.1.3",
    "typescript": "^6.0.3",
    "wrangler": "4.114.0"
  }
}
