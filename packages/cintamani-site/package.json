{
  "name": "@cintamani/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "generate:data": "node scripts/generate-domain-snapshots.mjs --write",
    "check:data": "node scripts/generate-domain-snapshots.mjs --check",
    "db:check": "node scripts/check-public-d1.mjs",
    "db:check:populated": "node scripts/check-public-d1-populated.mjs",
    "db:migrate:local": "wrangler d1 migrations apply PROPOSALS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PROPOSALS_DB --remote",
    "operator:bootstrap": "node scripts/bootstrap-operator.mjs",
    "x402:agent": "node scripts/x402-agent-fixture.mjs",
    "prepare:admission": "node scripts/prepare-domain-admission.mjs",
    "dev:astro": "pnpm --filter @narada-core/ui build && pnpm run generate:data && astro dev",
    "dev": "pnpm run build && pnpm run db:migrate:local && wrangler dev --local",
    "preview:audit": "pnpm run build && astro preview --host 127.0.0.1 --port 8787",
    "build": "pnpm --filter @narada-core/ui build && pnpm run generate:data && astro build",
    "check": "pnpm run check:data && pnpm run db:check && astro check",
    "test": "node --test tests/*.test.mjs",
    "test:visual": "playwright test --config playwright.config.mjs",
    "preview:static": "astro preview",
    "preview": "pnpm run dev",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "ship": "pnpm run build && pnpm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@narada-core/ui": "workspace:*",
    "@base-org/account": "2.5.9",
    "@coinbase/x402": "2.1.0",
    "@x402/core": "2.22.0",
    "@x402/evm": "2.22.0",
    "@x402/extensions": "2.22.0",
    "@x402/fetch": "2.22.0",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "1.62.1",
    "@astrojs/markdown-remark": "7.2.1",
    "astro": "7.1.3",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "wrangler": "4.114.0"
  }
}
