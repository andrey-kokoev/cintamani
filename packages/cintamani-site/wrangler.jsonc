{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cintamani",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-11",
  "d1_databases": [
    {
      "binding": "PROPOSALS_DB",
      "database_name": "cintamani-public-proposals",
      "database_id": "562103ed-5b70-4409-9135-198da6677452",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_WRITE_LIMIT_PER_HOUR": "30",
    "PUBLIC_ORIGIN": "https://cintamani.andrei-kokoev.workers.dev",
    "MODERATOR_GITHUB_LOGINS": "andrey-kokoev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAENUfPxF9YQlzAqL",
    "GITHUB_CLIENT_ID": "Ov23liehvWcvcG4rV7qE"
  },
  "observability": {
    "enabled": true
  }
}
