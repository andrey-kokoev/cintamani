---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { illustrativeExperimentCatalog } from '../../lib/experiments.mjs'
const experiments = illustrativeExperimentCatalog.items
---

<SiteLayout
  title="Proposed experiments | Cintamani"
  description="Illustrative, unadmitted experiment definitions for bounded scientific criticism."
>
  <main class="catalog" aria-labelledby="page-title">
    <p class="eyebrow">Research design · illustrative boundary</p>
    <h1 id="page-title">Proposed experiments</h1>
    <p class="lede">Canonical-shaped, versioned experiment proposals for criticism. Every card is explicitly unadmitted: it is not a run, result, evidence record, ranking, or production plan.</p>
    <p class="origin-note"><strong>Conjectural origin story:</strong> volumetric recurrent calculation is presented as a design-origin hypothesis only. <a href="/volumetric-recurrent-computing">Read the boundary statement</a>.</p>
    <nav class="catalog-links" aria-label="Related catalogs"><a href="/equipment-types/">Equipment capability types</a><a href="/research-topics/">Research topics</a><a href="/experiment-results/">Experiment results</a><a href="/research-memory/">Research memory</a><a href="/proposals/new">Propose a revision</a></nav>
    <section class="grid" aria-label="Illustrative experiment proposals">
      {experiments.map((experiment) => (
        <article class="card">
          <p class="meta"><span class="badge">{experiment.status}</span> · revision {experiment.revision} · {experiment.experiment_kind} · {experiment.intent}</p>
          <h2><a href={`/experiments/${experiment.experiment_id}`}>{experiment.title}</a></h2>
          <p>{experiment.protocols[0].minimal_decisive_test}</p>
          <h3>Strongest falsifier</h3>
          <p>{experiment.falsifiers[0].statement}</p>
          <h3>Equipment capabilities</h3>
          <ul>
            {experiment.equipment_requirements.map((requirement) => <li><strong>{requirement.group_kind}:</strong> {requirement.capability} ({requirement.selection_rule}, quantity {requirement.quantity})</li>)}
          </ul>
          <p><a href={`/api/experiments/${experiment.experiment_id}`}>Agent-readable JSON</a></p>
        </article>
      ))}
    </section>
  </main>
</SiteLayout>

<style>
  .catalog { max-width: 1120px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
  .eyebrow, .meta { color: #5d6675; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 14ch; font-size: clamp(2.5rem, 7vw, 5.6rem); line-height: .95; margin: .35rem 0 1.25rem; }
  .lede { max-width: 72ch; font-size: 1.18rem; line-height: 1.65; }
  .origin-note { border-left: 4px solid #a4572b; background: #fff4e9; padding: 1rem 1.1rem; max-width: 78ch; line-height: 1.55; }
  .catalog-links { display: flex; flex-wrap: wrap; gap: .75rem 1.2rem; margin: 1.6rem 0 2rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1rem; }
  .card { border: 1px solid #d7dce3; border-radius: .65rem; padding: 1.2rem; background: #fff; box-shadow: 0 6px 18px #17212b0d; }
  .card h2 { font-size: 1.35rem; line-height: 1.15; }
  .card h3 { font-size: .85rem; margin-bottom: .25rem; }
  .card p, .card li { line-height: 1.55; }
  .card ul { padding-left: 1.2rem; }
  .badge { color: #7d341f; font-weight: 700; }
  a { color: #0a5275; }
</style>
