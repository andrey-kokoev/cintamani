---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { illustrativeEquipmentCatalog } from '../../lib/experiments.mjs'

export function getStaticPaths() {
  return illustrativeEquipmentCatalog.items.map((item) => ({ params: { equipment_type_id: item.equipment_type_id }, props: { item } }))
}

const { item } = Astro.props
---

<SiteLayout
  title={`${item.title} | Cintamani`}
  description={`${item.title}: an illustrative, unadmitted equipment capability type.`}
>
  <main class="detail" aria-labelledby="page-title">
    <p class="eyebrow">Illustrative · unadmitted · revision {item.revision}</p>
    <h1 id="page-title">{item.title}</h1>
    <p class="boundary">This is a capability type, not an inventory or procurement record. It does not claim that the capability exists, is available, or supports any scientific result.</p>
    <p><strong>Stable identifier:</strong> <code>{item.equipment_type_id}</code></p>
    <p>{item.description}</p>
    <section aria-labelledby="capability-title"><h2 id="capability-title">Capabilities</h2><table><thead><tr><th scope="col">Capability</th><th scope="col">Units</th><th scope="col">Specification</th></tr></thead><tbody>{item.capabilities.map((capability) => <tr><th scope="row">{capability.capability}</th><td>{capability.units}</td><td>{capability.specification}</td></tr>)}</tbody></table></section>
    <section aria-labelledby="limit-title"><h2 id="limit-title">Operating limits</h2><ul>{item.operating_limits.map((limit) => <li><strong>{limit.parameter}:</strong> {limit.lower_bound}–{limit.upper_bound} {limit.units}. {limit.notes}</li>)}</ul></section>
    <section aria-labelledby="calibration-title"><h2 id="calibration-title">Calibration</h2><ul>{item.calibrations.map((calibration) => <li><strong>{calibration.quantity}:</strong> {calibration.method}; traceability: {calibration.traceability}.</li>)}</ul></section>
    <section aria-labelledby="safety-title"><h2 id="safety-title">Safety requirements</h2><ul>{item.safety_requirements.map((safety) => <li><strong>{safety.hazard}:</strong> {safety.requirement}; mitigation: {safety.mitigation}.</li>)}</ul></section>
    <section aria-labelledby="interface-title"><h2 id="interface-title">Interfaces</h2><ul>{item.interface_requirements.map((requirement) => <li><strong>{requirement.interface_kind}:</strong> {requirement.specification} ({requirement.units})</li>)}</ul></section>
    <section aria-labelledby="nonclaim-title"><h2 id="nonclaim-title">Nonclaims</h2><ul>{item.nonclaims.map((nonclaim) => <li>{nonclaim}</li>)}</ul></section>
    <section aria-labelledby="provenance-title"><h2 id="provenance-title">Available citations</h2>{item.citations.length > 0 ? <ul>{item.citations.map((citation) => <li><a href={citation.url}>{citation.label}</a> <code>{citation.source_id}</code></li>)}</ul> : <p>No external citation was supplied in the task context.</p>}</section>
    <p class="actions"><a href={`/api/equipment-types/${item.equipment_type_id}`}>Agent-readable JSON</a> · <a href={`/api/equipment-types/${item.equipment_type_id}/history`}>History</a> · <a href={`/api/equipment-types/${item.equipment_type_id}/provenance`}>Provenance</a> · <a href="/equipment-types/">Back to equipment types</a></p>
  </main>
</SiteLayout>

<style>
  .detail { max-width: 940px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
  .eyebrow { color: #7d341f; letter-spacing: .08em; font-size: .8rem; text-transform: uppercase; }
  h1 { font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1; max-width: 18ch; }
  h2 { margin-top: 2.2rem; border-bottom: 1px solid #d7dce3; padding-bottom: .35rem; }
  p, li, td, th { line-height: 1.55; }
  .boundary { border: 2px solid #a4572b; background: #fff4e9; padding: 1rem; font-weight: 600; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid #d7dce3; padding: .6rem; text-align: left; vertical-align: top; }
  th { background: #f2f5f7; }
  .actions { margin-top: 2.5rem; }
  a { color: #0a5275; }
</style>
