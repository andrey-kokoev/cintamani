---
import SiteLayout from '../layouts/SiteLayout.astro'
import dimensionsSnapshot from '../data/dimensions.json'
import frontierSnapshot from '../data/frontier.json'
import registrySummary from '../data/registry-summary.json'

interface DimensionMember {
  member_order: number
  member_id: string
  member_name: string
  current_assessment_id: string | null
  current_assessment_revision: number | null
  current_assessment_status: string | null
  current_assessment_detail: string | null
  assessed_at: string | null
  assessment_rationale: string | null
  assessment_scope: string | null
  source_admission_id: string | null
}

interface Dimension {
  dimension_order: number
  dimension_key: string
  dimension_name: string
  dimension_role: string
  member_count: number
  members: DimensionMember[]
}

interface FrontierItem {
  coordinate_key: string
  coordinate_key_version: string
  validation_generation: string
  classification: 'admitted-cell' | 'gap'
  model_id: string
  material_id: string
  mechanism_id: string
  interface_id: string
  cell_id: string | null
  cell_name: string | null
  status: string | null
}

const dimensions = dimensionsSnapshot.items as Dimension[]
const frontier = frontierSnapshot.items as FrontierItem[]
const admittedCells = frontier.filter((item) => item.classification === 'admitted-cell')
const gaps = frontier.filter((item) => item.classification === 'gap')
const label = (value: string | null) => value ? value.replaceAll('-', ' ') : 'unassessed'
---
<SiteLayout
  title="Cintamani · Categorical search registry"
  description="A checked static view of Cintamani's ordered computation-model, material, mechanism, and observation-interface search space."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Categorical research map · schema {registrySummary.schema_version}</p>
      <h1 id="hero-title">Search the space of<br /><em>physical computation.</em></h1>
      <p class="lede">
        Cintamani organizes computation claims by the model they assume, the material they may inhabit,
        and the physical mechanism that performs the work. Observation interface is shown honestly as a
        later fourth dimension.
      </p>
      <div class="hero-actions">
        <a class="primary-action" href="#dimensions">Explore the search space</a>
        <a class="primary-action primary-action--quiet" href="/research-topics/">Open research topics</a>
        <a class="primary-action primary-action--quiet" href="/proposals/">Propose or criticize</a>
        <a class="text-action" href="#authority">How this view is governed</a>
      </div>
    </div>
    <aside class="coordinate-card" aria-label="Current registry coordinates">
      <p class="coordinate-kicker">Current bounded projection</p>
      <dl class="metric-grid">
        <div><dt>Dimensions</dt><dd>{dimensions.length}</dd></div>
        <div><dt>Axis members</dt><dd>{dimensions.reduce((sum, axis) => sum + axis.member_count, 0)}</dd></div>
        <div><dt>Admitted cells</dt><dd>{admittedCells.length}</dd></div>
        <div><dt>Explicit gaps</dt><dd>{gaps.length}</dd></div>
      </dl>
      <div class="coordinate-lines" aria-hidden="true">
        {dimensions.map((axis) => (
          <span style={`--axis:${axis.dimension_order}`}><i></i><b>{axis.dimension_order}</b></span>
        ))}
      </div>
      <p class="coordinate-note">A coordinate is organizational memory, not experimental proof.</p>
    </aside>
  </section>

  <section class="section-shell origin-section" aria-labelledby="origin-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The originating conjecture</p>
        <h2 id="origin-title">Volumetric Recurrent Computing started this search</h2>
      </div>
      <p>
        Cintamani began by asking whether persistent physical state can acquire useful computational
        depth through repeated evolution in one configured nonlinear three-dimensional medium.
      </p>
    </div>
    <div class="snapshot-callout">
      <p>
        The first selected simulated regime failed to gain reliable task accuracy from recurrence. That
        criticism narrowed the program; it did not silently erase the conjecture. The registry, research
        topics, and public criticism plane grew from the need to test its model, material, mechanism,
        control, and observation assumptions separately.
      </p>
      <a class="primary-action" href="/volumetric-recurrent-computing/">Read the originating conjecture</a>
    </div>
  </section>

  <section class="authority-strip" id="authority" aria-label="Registry authority summary">
    <div>
      <span class="status-light" aria-hidden="true"></span>
      <p><strong>Registry check passed</strong><br />Integrity {registrySummary.integrity}; chain consistent.</p>
    </div>
    <div>
      <span class="strip-index">{registrySummary.registry_counts.admissions}</span>
      <p><strong>Immutable admissions</strong><br />Generation {registrySummary.chain_generation}</p>
    </div>
    <div>
      <span class="strip-index">0</span>
      <p><strong>Live edge mutations</strong><br />Static JSON, generated during build.</p>
    </div>
  </section>

  <section class="section-shell" id="dimensions" aria-labelledby="dimensions-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The search volume</p>
        <h2 id="dimensions-title">Four ordered dimensions</h2>
      </div>
      <p>
        Axes 1–3 preserve the original three-dimensional conjecture. Axis 4 records the observation
        boundary added later; the distinction is part of the data contract.
      </p>
    </div>

    <ol class="dimension-grid">
      {dimensions.map((axis) => (
        <li class:list={['dimension-card', axis.dimension_order === 4 && 'dimension-card--later']}>
          <header>
            <span class="dimension-number" aria-label={`Dimension ${axis.dimension_order}`}>{axis.dimension_order}</span>
            <div>
              <p class="dimension-role">
                {axis.dimension_order === 4 ? 'Later-added fourth dimension' : 'Original 3D axis'}
              </p>
              <h3>{axis.dimension_name}</h3>
            </div>
          </header>
          <p class="member-count">{axis.member_count} admitted {axis.member_count === 1 ? 'member' : 'members'}</p>
          {axis.members.length === 0 ? (
            <p class="empty-axis">No members have been admitted on this axis.</p>
          ) : (
            <ul class="member-list">
              {axis.members.map((member) => (
                <li>
                  <div class="member-heading">
                    <strong>{member.member_name}</strong>
                    <span class="status-pill">{label(member.current_assessment_status)}</span>
                  </div>
                  <code>{member.member_id}</code>
                  {member.current_assessment_detail && (
                    <p class="assessment-detail">Classification: {label(member.current_assessment_detail)}</p>
                  )}
                  <details>
                    <summary>Assessment &amp; provenance</summary>
                    <p>{member.assessment_rationale}</p>
                    <dl class="provenance-list">
                      <div><dt>Revision</dt><dd>{member.current_assessment_revision ?? '—'}</dd></div>
                      <div><dt>Assessed</dt><dd>{member.assessed_at ?? '—'}</dd></div>
                      <div><dt>Scope</dt><dd>{member.assessment_scope ?? '—'}</dd></div>
                      <div><dt>Admission</dt><dd><code>{member.source_admission_id ?? '—'}</code></dd></div>
                    </dl>
                  </details>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="section-shell frontier-section" id="frontier" aria-labelledby="frontier-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Bounded Cartesian view</p>
        <h2 id="frontier-title">Admitted cells and honest gaps</h2>
      </div>
      <p>
        Every displayed coordinate is present in the bounded four-axis frontier. A gap means “not
        admitted,” not “refuted” and not “physically impossible.”
      </p>
    </div>
    <div class="frontier-legend" aria-label="Frontier legend">
      <span><i class="legend-dot legend-dot--cell"></i> Admitted cell</span>
      <span><i class="legend-dot legend-dot--gap"></i> Explicit gap</span>
    </div>
    <div class="frontier-grid">
      {frontier.map((item) => (
        <article class:list={['frontier-card', item.classification === 'gap' ? 'frontier-card--gap' : 'frontier-card--cell']}>
          <header>
            <p>{item.classification === 'gap' ? 'Unadmitted coordinate' : 'Governed search cell'}</p>
            <span>{item.classification === 'gap' ? 'gap' : label(item.status)}</span>
          </header>
          <h3>{item.cell_name ?? 'No cell occupies this coordinate'}</h3>
          {item.cell_id && <code>{item.cell_id}</code>}
          <dl class="axis-coordinates">
            <div><dt>Model</dt><dd>{label(item.model_id)}</dd></div>
            <div><dt>Material</dt><dd>{label(item.material_id)}</dd></div>
            <div><dt>Mechanism</dt><dd>{label(item.mechanism_id)}</dd></div>
            <div><dt>Interface</dt><dd>{label(item.interface_id)}</dd></div>
          </dl>
          {item.classification === 'gap' && (
            <p class="gap-note">No governed evidence-bearing cell has been admitted here.</p>
          )}
          <a
            class="text-action frontier-conjecture-link"
            href={`/proposals/new/?coordinate=${encodeURIComponent(item.coordinate_key)}&generation=${encodeURIComponent(item.validation_generation)}`}
            target="_blank"
            rel="noopener"
          >
            Frame a conjecture here <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-action frontier-topic-link"
            href={`/proposals/new/?kind=research-topic&coordinate=${encodeURIComponent(item.coordinate_key)}&generation=${encodeURIComponent(item.validation_generation)}`}
            target="_blank"
            rel="noopener"
          >
            Propose a topic here <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell limits-section" id="limits" aria-labelledby="limits-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Epistemic perimeter</p>
        <h2 id="limits-title">What this registry does not claim</h2>
      </div>
      <p>The interface makes boundaries prominent because a navigable taxonomy can otherwise look stronger than its evidence.</p>
    </div>
    <ul class="limits-grid">
      <li><span>01</span><p><strong>No LiTaO3 validation.</strong> Thin-film LiTaO3 is an unvalidated candidate, not an admitted physical device cell.</p></li>
      <li><span>02</span><p><strong>No physical detector calibration.</strong> The admitted gate used normalized additive observation noise.</p></li>
      <li><span>03</span><p><strong>No replicated nonlinear computation.</strong> The earned lead is narrow, local, and linear-memory only.</p></li>
      <li><span>04</span><p><strong>No Conjecture 5 or connected-region claim.</strong> Gaps remain invitations to criticism, not conclusions.</p></li>
    </ul>
  </section>

  <section class="snapshot-callout" aria-labelledby="snapshot-title">
    <p class="eyebrow">Cloudflare delivery boundary</p>
    <h2 id="snapshot-title">Fast at the edge. Static by design.</h2>
    <p>
      Cloudflare Workers Assets serves the checked registry snapshot. A separate public D1 plane now
      accepts immediately visible, explicitly unreviewed proposals and criticism; it cannot mutate the
      canonical registry. Only a maintainer-selected, content-addressed export can enter the existing
      domain admission preview and promotion workflow.
    </p>
  </section>
</SiteLayout>
