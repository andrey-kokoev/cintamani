  .vrc-origin-hero { padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
  .vrc-origin-page h1 { max-width: 13ch; margin: .55rem 0 1rem; font-size: clamp(3rem, 8vw, 6.5rem); line-height: .92; letter-spacing: -.055em; }
  .vrc-origin-page h2 { max-width: 23ch; margin: .4rem 0 1rem; font-size: clamp(1.65rem, 4vw, 2.6rem); }
  .vrc-origin-page section { padding: 2.7rem 0; border-bottom: 1px solid var(--line); }
  .vrc-origin-page p, .vrc-origin-page li { max-width: 70ch; line-height: 1.72; }
  .vrc-origin-page blockquote { margin: 1.4rem 0; padding: 1.4rem 1.6rem; border-left: .25rem solid var(--ochre); background: var(--panel); font-size: 1.2rem; line-height: 1.6; }
  .origin-status { padding: .85rem 1rem; background: var(--ochre-soft); border-radius: .4rem; }
