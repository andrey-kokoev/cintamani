{
  "name": "cintamani",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm --recursive run check",
    "test": "pnpm --recursive run test",
    "domain:init": "pnpm --filter @cintamani/domain domain:init",
    "domain:rebuild": "pnpm --filter @cintamani/domain domain:rebuild",
    "domain:check": "pnpm --filter @cintamani/domain domain:check",
    "domain:list": "pnpm --filter @cintamani/domain domain:list"
  }
}
